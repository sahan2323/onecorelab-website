# PostgreSQL connection string
# e.g. postgres://user:password@localhost:5432/onecorelab
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onecorelab

# Random 32+ char secret used to sign admin session cookies
AUTH_SECRET=replace-this-with-a-long-random-string

# Credentials used only by db/seed.ts to create the first Super Admin
SEED_SUPER_ADMIN_EMAIL=founder@onecorelab.com
SEED_SUPER_ADMIN_PASSWORD=ChangeThisPassword123!
